<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_fleet_inspection" model="ir.sequence">
        <field name="name">Fleet Inspection</field>
        <field name="code">fleet.inspection</field>
        <field name="prefix">INS/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_fleet_job_card" model="ir.sequence">
        <field name="name">Fleet Job Card</field>
        <field name="code">fleet.job.card</field>
        <field name="prefix">JOB/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_fleet_job_material_request" model="ir.sequence">
        <field name="name">Fleet Job Material Request</field>
        <field name="code">fleet.job.material.request</field>
        <field name="prefix">MR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
