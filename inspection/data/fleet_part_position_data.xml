    </record>
    <record id="position_spare" model="fleet.vehicle.part.position">
        <field name="name">Spare Wheel</field><field name="code">SPARE</field><field name="sequence">300</field>
    </record>
    <record id="position_battery" model="fleet.vehicle.part.position">
        <field name="name">Battery</field><field name="code">BAT</field>
        <field name="sequence">400</field><field name="part_type">battery</field>
    </record>
</odoo>
