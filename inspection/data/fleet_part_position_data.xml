<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Wheel positions matching the tyre checklist of the inspection sheet.
         F = steer axle, D1/D2 = drive axles (L/R = left/right, I/O = inner/outer),
         SEMI/LINK & LINK/DENGLER = trailer wheels. -->
    <record id="position_fl" model="fleet.vehicle.part.position">
        <field name="name">Front Left</field><field name="code">FL</field>
        <field name="sequence">10</field><field name="axle">1</field><field name="side">left</field>
    </record>
    <record id="position_fr" model="fleet.vehicle.part.position">
        <field name="name">Front Right</field><field name="code">FR</field>
        <field name="sequence">20</field><field name="axle">1</field><field name="side">right</field>
    </record>
    <record id="position_d1li" model="fleet.vehicle.part.position">
        <field name="name">Drive 1 Left Inner</field><field name="code">D1LI</field>
        <field name="sequence">30</field><field name="axle">2</field><field name="side">left</field>
    </record>
    <record id="position_d1lo" model="fleet.vehicle.part.position">
        <field name="name">Drive 1 Left Outer</field><field name="code">D1LO</field>
        <field name="sequence">40</field><field name="axle">2</field><field name="side">left</field>
    </record>
    <record id="position_d1ri" model="fleet.vehicle.part.position">
        <field name="name">Drive 1 Right Inner</field><field name="code">D1RI</field>
        <field name="sequence">50</field><field name="axle">2</field><field name="side">right</field>
    </record>
    <record id="position_d1ro" model="fleet.vehicle.part.position">
        <field name="name">Drive 1 Right Outer</field><field name="code">D1RO</field>
        <field name="sequence">60</field><field name="axle">2</field><field name="side">right</field>
    </record>
    <record id="position_d2li" model="fleet.vehicle.part.position">
        <field name="name">Drive 2 Left Inner</field><field name="code">D2LI</field>
        <field name="sequence">70</field><field name="axle">3</field><field name="side">left</field>
    </record>
    <record id="position_d2lo" model="fleet.vehicle.part.position">
        <field name="name">Drive 2 Left Outer</field><field name="code">D2LO</field>
        <field name="sequence">80</field><field name="axle">3</field><field name="side">left</field>
    </record>
    <record id="position_d2ri" model="fleet.vehicle.part.position">
        <field name="name">Drive 2 Right Inner</field><field name="code">D2RI</field>
        <field name="sequence">90</field><field name="axle">3</field><field name="side">right</field>
    </record>
    <record id="position_d2ro" model="fleet.vehicle.part.position">
        <field name="name">Drive 2 Right Outer</field><field name="code">D2RO</field>
        <field name="sequence">100</field><field name="axle">3</field><field name="side">right</field>
    </record>
    <record id="position_semi_1" model="fleet.vehicle.part.position">
        <field name="name">Semi / Link 1</field><field name="code">SL01</field><field name="sequence">110</field>
    </record>
    <record id="position_semi_2" model="fleet.vehicle.part.position">
        <field name="name">Semi / Link 2</field><field name="code">SL02</field><field name="sequence">120</field>
    </record>
    <record id="position_semi_3" model="fleet.vehicle.part.position">
        <field name="name">Semi / Link 3</field><field name="code">SL03</field><field name="sequence">130</field>
    </record>
    <record id="position_semi_4" model="fleet.vehicle.part.position">
