<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="job_type_mechanical" model="fleet.inspection.job.type">
            <field name="name">Mechanical</field>
            <field name="code">MECH</field>
            <field name="sequence">10</field>
            <field name="color">4</field>
        </record>
        <record id="job_type_electrical" model="fleet.inspection.job.type">
            <field name="name">Electrical</field>
            <field name="code">ELEC</field>
            <field name="sequence">20</field>
            <field name="color">3</field>
        </record>
        <record id="job_type_body" model="fleet.inspection.job.type">
            <field name="name">Body &amp; Chassis</field>
            <field name="code">BODY</field>
            <field name="sequence">30</field>
            <field name="color">9</field>
        </record>
        <record id="job_type_tyres" model="fleet.inspection.job.type">
            <field name="name">Tyres &amp; Wheels</field>
            <field name="code">TYRE</field>
            <field name="sequence">40</field>
            <field name="color">10</field>
        </record>

        <record id="config_overdue_days" model="ir.config_parameter">
            <field name="key">inspection.overdue_days</field>
            <field name="value">7</field>
        </record>
    </data>

    <!-- Idempotent: only categories / lines without a job type are touched -->
    <function model="fleet.inspection.category" name="_assign_default_job_types"/>
</odoo>
