<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Role ladder (one selection on the user form):
            Inspector / Mechanic  <  Workshop Supervisor  <  Fleet Manager  <  Administrator
        Functional roles (check boxes on the user form):
            Store Keeper, Procurement Officer
    -->
    <record id="module_category_fleet_inspection" model="ir.module.category">
        <field name="name">Fleet Inspection &amp; Workshop</field>
        <field name="sequence">20</field>
    </record>

    <record id="module_category_fleet_workshop" model="ir.module.category">
        <field name="name">Fleet Workshop: Stores &amp; Purchasing</field>
        <field name="sequence">21</field>
    </record>

    <record id="group_inspection_inspector" model="res.groups">
        <field name="name">Inspector / Mechanic</field>
        <field name="category_id" ref="module_category_fleet_inspection"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Performs inspections, works on the job cards assigned to them, logs labour,
requests materials and records part fitments.</field>
    </record>

    <record id="group_workshop_supervisor" model="res.groups">
        <field name="name">Workshop Supervisor</field>
        <field name="category_id" ref="module_category_fleet_inspection"/>
        <field name="implied_ids" eval="[(4, ref('group_inspection_inspector'))]"/>
        <field name="comment">Sees every inspection and job card, approves job cards (below the Fleet Manager
threshold) and material requests, performs the quality check.</field>
    </record>

    <record id="group_inspection_manager" model="res.groups">
        <field name="name">Fleet Manager</field>
        <field name="category_id" ref="module_category_fleet_inspection"/>
        <field name="implied_ids" eval="[(4, ref('group_workshop_supervisor')), (4, ref('stock.group_stock_user')), (4, ref('purchase.group_purchase_user'))]"/>
        <field name="comment">Approves inspections and high-value job cards, sees costs, transfers and purchases.</field>
    </record>

    <record id="group_workshop_storekeeper" model="res.groups">
        <field name="name">Store Keeper</field>
        <field name="category_id" ref="module_category_fleet_workshop"/>
        <field name="implied_ids" eval="[(4, ref('group_inspection_inspector')), (4, ref('stock.group_stock_user'))]"/>
        <field name="comment">Checks availability, issues materials (with serial numbers) and receives returns.</field>
    </record>

    <record id="group_workshop_procurement" model="res.groups">
        <field name="name">Procurement Officer</field>
        <field name="category_id" ref="module_category_fleet_workshop"/>
        <field name="implied_ids" eval="[(4, ref('group_inspection_inspector')), (4, ref('purchase.group_purchase_user'))]"/>
        <field name="comment">Creates and confirms purchase orders for material shortages.</field>
    </record>

    <record id="group_inspection_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_fleet_inspection"/>
        <field name="implied_ids" eval="[(4, ref('group_inspection_manager')), (4, ref('group_workshop_storekeeper')), (4, ref('group_workshop_procurement')), (4, ref('fleet.fleet_group_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Full access including configuration.</field>
    </record>

    <!-- ======================= INSPECTIONS ======================= -->
    <record id="rule_inspection_inspector_own" model="ir.rule">
        <field name="name">Inspection: Inspector reads own / assigned inspections</field>
        <field name="model_id" ref="model_fleet_inspection"/>
        <field name="groups" eval="[(4, ref('group_inspection_inspector'))]"/>
        <field name="domain_force">['|', '|', ('create_uid', '=', user.id), ('mechanic_id.user_id', '=', user.id), ('service_ids.technician_id.user_id', '=', user.id)]</field>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

    <record id="rule_inspection_inspector_edit" model="ir.rule">
        <field name="name">Inspection: Inspector edits own inspections until completed</field>
        <field name="model_id" ref="model_fleet_inspection"/>
        <field name="groups" eval="[(4, ref('group_inspection_inspector'))]"/>
        <field name="domain_force">['&amp;', '|', ('create_uid', '=', user.id), ('mechanic_id.user_id', '=', user.id), ('state', 'in', ('draft', 'in_progress'))]</field>
        <field name="perm_read">0</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">0</field>
    </record>

    <record id="rule_inspection_manager_all" model="ir.rule">
        <field name="name">Inspection: Supervisor / Manager full access</field>
        <field name="model_id" ref="model_fleet_inspection"/>
        <field name="groups" eval="[(4, ref('group_workshop_supervisor'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_inspection_company" model="ir.rule">
        <field name="name">Inspection: multi-company</field>
        <field name="model_id" ref="model_fleet_inspection"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- ======================= JOB CARDS ======================= -->
    <record id="rule_job_card_mechanic" model="ir.rule">
        <field name="name">Job Card: Mechanic sees own / assigned job cards</field>
        <field name="model_id" ref="fleet.model_fleet_vehicle_log_services"/>
        <field name="groups" eval="[(4, ref('group_inspection_inspector'))]"/>
        <field name="domain_force">['|', '|', '|', ('create_uid', '=', user.id), ('technician_id.user_id', '=', user.id), ('supervisor_id.user_id', '=', user.id), ('labour_line_ids.employee_id.user_id', '=', user.id)]</field>
        <field name="perm_unlink">0</field>
    </record>

    <record id="rule_job_card_stores_read" model="ir.rule">
        <field name="name">Job Card: Stores / Procurement read all</field>
        <field name="model_id" ref="fleet.model_fleet_vehicle_log_services"/>
        <field name="groups" eval="[(4, ref('group_workshop_storekeeper')), (4, ref('group_workshop_procurement'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

    <record id="rule_job_card_supervisor_all" model="ir.rule">
        <field name="name">Job Card: Supervisor / Manager full access</field>
        <field name="model_id" ref="fleet.model_fleet_vehicle_log_services"/>
        <field name="groups" eval="[(4, ref('group_workshop_supervisor'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- ======================= MATERIAL REQUESTS ======================= -->
    <record id="rule_material_request_mechanic" model="ir.rule">
        <field name="name">Material Request: Mechanic sees own / own job requests</field>
        <field name="model_id" ref="model_fleet_job_material_request"/>
        <field name="groups" eval="[(4, ref('group_inspection_inspector'))]"/>
        <field name="domain_force">['|', '|', ('requested_by', '=', user.id), ('job_id.technician_id.user_id', '=', user.id), ('job_id.create_uid', '=', user.id)]</field>
        <field name="perm_unlink">0</field>
    </record>

    <record id="rule_material_request_all" model="ir.rule">
        <field name="name">Material Request: Supervisor / Stores / Procurement full access</field>
        <field name="model_id" ref="model_fleet_job_material_request"/>
        <field name="groups" eval="[(4, ref('group_workshop_supervisor')), (4, ref('group_workshop_storekeeper')), (4, ref('group_workshop_procurement'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_material_request_company" model="ir.rule">
        <field name="name">Material Request: multi-company</field>
        <field name="model_id" ref="model_fleet_job_material_request"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <!-- ======================= CONFIGURATION / PARTS ======================= -->
    <record id="rule_workshop_company" model="ir.rule">
        <field name="name">Workshop: multi-company</field>
        <field name="model_id" ref="model_fleet_workshop"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_installed_part_company" model="ir.rule">
        <field name="name">Installed Part: multi-company</field>
        <field name="model_id" ref="model_fleet_vehicle_installed_part"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_job_type_company" model="ir.rule">
        <field name="name">Job Type: multi-company</field>
        <field name="model_id" ref="model_fleet_inspection_job_type"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
