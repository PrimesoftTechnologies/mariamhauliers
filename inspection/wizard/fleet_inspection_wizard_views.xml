<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ======================= CREATE JOB CARDS ======================= -->
    <record id="view_fleet_inspection_job_card_wizard_form" model="ir.ui.view">
        <field name="name">fleet.inspection.job.card.wizard.form</field>
        <field name="model">fleet.inspection.job.card.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Job Cards">
                <group>
                    <group>
                        <field name="inspection_id" readonly="1" force_save="1"/>
                        <field name="vehicle_id"/>
                    </group>
                    <group>
                        <field name="split_mode" widget="radio"/>
                        <field name="single_job_type_id" invisible="split_mode != 'single'"
                               options="{'no_create': True}"/>
                    </group>
                </group>
                <div class="d-flex gap-2 mb-2">
                    <button name="action_select_all" type="object" string="Select All" class="btn-link p-0"/>
                    <button name="action_select_none" type="object" string="Select None" class="btn-link p-0"/>
                </div>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0"
                          decoration-danger="severity == 'high'" decoration-muted="not selected">
                        <field name="selected" widget="boolean_toggle"/>
                        <field name="category_id"/>
                        <field name="item_id"/>
                        <field name="severity" widget="badge"
                               decoration-danger="severity == 'high'"
                               decoration-warning="severity == 'medium'"/>
                        <field name="comment"/>
                        <field name="is_repeat_defect" optional="show"/>
                        <field name="job_type_id" options="{'no_create': True}"
                               column_invisible="parent.split_mode == 'single'"/>
                        <field name="inspection_line_id" column_invisible="1"/>
                    </list>
                </field>
                <div class="alert alert-info mt-2 mb-0" role="status">
                    <field name="summary" nolabel="1"/>
                </div>
                <footer>
                    <button name="action_create" type="object" string="Create Job Cards" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ======================= SUMMARY REPORT ======================= -->
    <record id="view_fleet_inspection_report_wizard_form" model="ir.ui.view">
        <field name="name">fleet.inspection.report.wizard.form</field>
        <field name="model">fleet.inspection.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Fleet Inspection Summary">
                <group>
                    <group string="Period">
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="include_unapproved"/>
                    </group>
                    <group string="Filters">
                        <field name="vehicle_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="mechanic_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="inspection_type"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print" type="object" string="Print PDF" class="btn-primary"
                            icon="fa-print"/>
                    <button name="action_view_list" type="object" string="View Inspections"
                            class="btn-secondary" icon="fa-list"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_fleet_inspection_report_wizard" model="ir.actions.act_window">
        <field name="name">Fleet Inspection Summary</field>
        <field name="res_model">fleet.inspection.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
