<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_fleet_inspection_item_list" model="ir.ui.view">
        <field name="name">fleet.inspection.item.list</field>
        <field name="model">fleet.inspection.item</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="category_id"/>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="default_severity"/>
                <field name="position_id" optional="show"/>
                <field name="vehicle_type_ids" widget="many2many_tags"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_fleet_inspection_item_search" model="ir.ui.view">
        <field name="name">fleet.inspection.item.search</field>
        <field name="model">fleet.inspection.item</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="category_id"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fleet_inspection_item" model="ir.actions.act_window">
        <field name="name">Inspection Items</field>
        <field name="res_model">fleet.inspection.item</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_category': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first checklist item</p>
        </field>
    </record>

</odoo>
