<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_fleet_vehicle_part_position_list" model="ir.ui.view">
        <field name="name">fleet.vehicle.part.position.list</field>
        <field name="model">fleet.vehicle.part.position</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="part_type"/>
                <field name="axle"/>
                <field name="side"/>
                <field name="vehicle_type_ids" widget="many2many_tags" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_fleet_vehicle_part_position_search" model="ir.ui.view">
        <field name="name">fleet.vehicle.part.position.search</field>
        <field name="model">fleet.vehicle.part.position</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <filter string="Tyres" name="tyres" domain="[('part_type', '=', 'tyre')]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Part Type" name="group_type" context="{'group_by': 'part_type'}"/>
                    <filter string="Axle" name="group_axle" context="{'group_by': 'axle'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fleet_vehicle_part_position" model="ir.actions.act_window">
        <field name="name">Part Positions</field>
        <field name="res_model">fleet.vehicle.part.position</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define wheel and part positions</p>
            <p>Positions (FL, FR, D1LI...) are linked to the tyre checklist items so that each
               inspection records the serial number, tread depth and pressure at each position.</p>
        </field>
    </record>

</odoo>
