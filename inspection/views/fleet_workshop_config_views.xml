<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fleet_workshop_list" model="ir.ui.view">
        <field name="name">fleet.workshop.list</field>
        <field name="model">fleet.workshop</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="warehouse_id"/>
                <field name="source_location_id" groups="stock.group_stock_multi_locations"/>
                <field name="location_id" groups="stock.group_stock_multi_locations"/>
                <field name="manager_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_fleet_workshop_form" model="ir.ui.view">
        <field name="name">fleet.workshop.form</field>
        <field name="model">fleet.workshop</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Dar es Salaam Workshop"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="manager_id"/>
                            <field name="default_vendor_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Spare Parts">
                            <field name="warehouse_id"/>
                            <field name="source_location_id"/>
                            <field name="location_id"/>
                            <field name="used_location_id"/>
                            <field name="default_picking_type_id"/>
                        </group>
                    </group>
                    <p class="text-muted">
                        Approved material requests reserve parts from <b>Issue From</b> (default: the warehouse
                        stock) and move them to the <b>Consumption Location</b> when the store issues them.
                        Purchased shortages are received in the warehouse and reserved automatically.
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fleet_workshop" model="ir.actions.act_window">
        <field name="name">Workshops</field>
        <field name="res_model">fleet.workshop</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define your workshop bays</p>
            <p>Link each workshop to a warehouse so materials can be reserved, purchased and issued automatically.
               Without a workshop the company's first warehouse is used.</p>
        </field>
    </record>
</odoo>
