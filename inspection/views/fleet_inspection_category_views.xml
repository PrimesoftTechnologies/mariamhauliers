<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_fleet_inspection_category_list" model="ir.ui.view">
        <field name="name">fleet.inspection.category.list</field>
        <field name="model">fleet.inspection.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="job_type_id" options="{'no_create': True}"/>
                <field name="vehicle_type_ids" widget="many2many_tags"/>
                <field name="item_count"/>
            </list>
        </field>
    </record>

    <record id="view_fleet_inspection_category_form" model="ir.ui.view">
        <field name="name">fleet.inspection.category.form</field>
        <field name="model">fleet.inspection.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Engine Assembly"/></h1>
                    </div>
                    <group>
                        <field name="sequence"/>
                        <field name="job_type_id" options="{'no_create': True}"/>
                        <field name="vehicle_type_ids" widget="many2many_tags"
                               help="Leave empty to apply to all vehicle types"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Checklist Items">
                            <field name="item_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="default_severity"/>
                                    <field name="position_id" optional="show"/>
                                    <field name="vehicle_type_ids" widget="many2many_tags"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fleet_inspection_category" model="ir.actions.act_window">
        <field name="name">Inspection Categories</field>
        <field name="res_model">fleet.inspection.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first inspection category</p>
            <p>Categories group checklist items, e.g. Engine Assembly, Cooling System, Brakes, Axle No. 1...</p>
        </field>
    </record>

</odoo>
