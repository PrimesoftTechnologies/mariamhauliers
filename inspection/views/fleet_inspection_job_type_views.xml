<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_fleet_inspection_job_type_list" model="ir.ui.view">
        <field name="name">fleet.inspection.job.type.list</field>
        <field name="model">fleet.inspection.job.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="service_type_id"/>
                <field name="responsible_id"/>
                <field name="workshop_id" optional="show"/>
                <field name="category_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_fleet_inspection_job_type_form" model="ir.ui.view">
        <field name="name">fleet.inspection.job.type.form</field>
        <field name="model">fleet.inspection.job.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Electrical"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="color" widget="color_picker"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="service_type_id"/>
                            <field name="responsible_id"/>
                            <field name="workshop_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Categories" name="categories">
                            <p class="text-muted">
                                Defects found in these checklist categories are routed to a job card of this type.
                            </p>
                            <field name="category_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="item_count"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fleet_inspection_job_type" model="ir.actions.act_window">
        <field name="name">Job Types</field>
        <field name="res_model">fleet.inspection.job.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a job type</p>
            <p>Job types (Mechanical, Electrical, Body, ...) decide how the defects of one inspection
               are split into several job cards.</p>
        </field>
    </record>

</odoo>
